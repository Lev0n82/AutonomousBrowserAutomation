{
  "manifest_version": 3,
  "name": "Autonomous Browser Assistant",
  "version": "0.2.1",
  "description": "Connect Chrome or Edge to a local Ollama-powered browser automation bridge.",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "debugger",
    "sidePanel",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Autonomous Browser Assistant"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html"
}
